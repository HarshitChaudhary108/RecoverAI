# Infrastructure Secrets
RAZORPAY_KEY_ID=rp_test_key_id
RAZORPAY_KEY_SECRET=rp_test_key_secret
RAZORPAY_WEBHOOK_SECRET=custom_webhook_secret_123
DATABASE_URL=postgresql://user:pass@host:5432/db
REDIS_URL=rediss://:pass@host:6379/0
NGROK_AUTHTOKEN=ngrok_token_abc
EMAIL_API_KEY=re_test_api_key
GROQ_API_KEY=gsk_test_api_key

# LangSmith
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=ls_test_api_key
LANGCHAIN_PROJECT=razorpay_failed_payment_recovery_agent

# Business Settings
# Recovery delays in minutes per category
RECOVERY_DELAYS='{"insufficient_funds": [2], "bank_declined_soft": [20, 120], "bank_declined_hard": [5], "timeout": [10], "user_cancelled": [180], "other": []}'
# Max recovery messages per payment
MAX_MESSAGES_PER_PAYMENT=3
# Quiet hours start (IST)
QUIET_HOURS_START=21:00
# Quiet hours end (IST)
QUIET_HOURS_END=09:00
# Quiet hours timezone
QUIET_HOURS_TIMEZONE=Asia/Kolkata
# Enable/disable quiet hours
QUIET_HOURS_ENABLED=true
# Recovery expiry in days
RECOVERY_EXPIRY_DAYS=7
# Attribution window in hours
RECOVERY_ATTRIBUTION_WINDOW_HOURS=48
# Holdout percent for impact measurement
HOLDOUT_PERCENT=10
# Holdout eligible categories (comma separated)
HOLDOUT_ELIGIBLE_CATEGORIES=insufficient_funds,bank_declined_soft,bank_declined_hard,timeout,user_cancelled
# Health monitoring window in minutes
HEALTH_WINDOW_MINUTES=60
# Min attempts for alert trigger
ALERT_MIN_ATTEMPTS=20
# Absolute success floor percent
ALERT_SUCCESS_FLOOR_PERCENT=70.0
# Success rate drop threshold percent
ALERT_DROP_THRESHOLD_PERCENT=15.0
# Baseline period in days
ALERT_BASELINE_DAYS=7
# Healthy checks to clear alert
ALERT_HEALTHY_CHECKS_TO_CLEAR=2
# Scheduler polling interval in seconds
SCHEDULER_INTERVAL_SECONDS=60
# Lease time for claimed actions in seconds
LEASE_TIME_SECONDS=300
# Retry backoff delays in seconds (comma separated)
RETRY_BACKOFF_FACTORS=60,300,1800
# Timeout re-check delay in minutes
TIMEOUT_RECHECK_DELAY_MINUTES=10
# Max re-checks for timeout payments
MAX_RECHECKS=6
